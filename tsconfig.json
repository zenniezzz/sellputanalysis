{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@pss/options": ["packages/options/src/index.ts"],
      "@pss/market-data": ["packages/market-data/src/index.ts"],
      "@pss/pipeline": ["packages/pipeline/src/index.ts"],
      "@pss/store": ["packages/store/src/index.ts"],
      "@pss/observability": ["packages/observability/src/index.ts"],
      "@pss/screen": ["packages/screen/src/index.ts"],
      "@pss/tracker": ["packages/tracker/src/index.ts"],
      "@pss/compare": ["packages/compare/src/index.ts"],
      "@pss/diff": ["packages/diff/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "apps/web", "**/dist", "**/.next"]
}
