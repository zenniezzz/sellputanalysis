# Auth.js — required. Generate: openssl rand -base64 33
AUTH_SECRET=dev-only-change-me-please-0000000000000000000

# Optional Google OAuth (both required to enable the provider)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Email magic-link "from" address (the dev transport just logs the link)
# EMAIL_FROM=no-reply@put-sell-screener.local

# Force-enable the dev credentials login outside NODE_ENV=development
# ALLOW_DEV_LOGIN=1

# Point the web app at Postgres instead of ../../.data JSON files — every
# store (snapshots, accounts, saved screens/watchlists, bookmarks, paper
# trades) switches over together, through one shared connection pool
# (app/lib/pg-pool.ts). Each table self-migrates on first use.
# DATABASE_URL=

# Override the JSON data directory (default: ../../.data)
# PSS_DATA_DIR=

# Error reporting (plan §10.7) — also `npm install @sentry/node` here first;
# it's not a dependency by default. No-op (console.error) without a DSN.
# SENTRY_DSN=

# Dead-man's-switch heartbeat, healthchecks.io-style (plan §10.7 alert #5).
# HEARTBEAT_URL_SNAPSHOT=
