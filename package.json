{
  "name": "put-sell-screener",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Daily put-selling options screener — see put-sell-screener-plan.md",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "cli:one-name": "tsx apps/screener-cli/src/one-name.ts",
    "cli:run-snapshot": "tsx apps/screener-cli/src/run-snapshot.ts",
    "cli:greek-xcheck": "tsx apps/screener-cli/src/greek-xcheck.ts",
    "api": "tsx apps/api/src/server.ts",
    "web": "npm -w @pss/web run dev",
    "web:build": "npm -w @pss/web run build",
    "typecheck:web": "npm -w @pss/web run typecheck",
    "cli:calibration": "tsx apps/screener-cli/src/calibration.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/pg": "^8.11.6",
    "black-scholes": "^1.1.0",
    "pg": "^8.12.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
